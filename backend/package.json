        "jsonwebtoken": "^9.0.3",
        "stripe": "^20.4.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.11.24",
        "@types/stripe": "^8.0.416",
        "prisma": "^5.10.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3"
    }
